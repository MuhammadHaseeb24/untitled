    {
     "id": "spears",
     "text": "Army dying, or winning? Tap the SPEARS button to rain spears from your statue onto the enemy. It recharges.",
     "highlight": "spear",
     "advance": "tap"
    },
    {
     "id": "finish",
     "text": "Switch back to DEFEND or ATTACK, keep your miners alive, and destroy the enemy statue!",
